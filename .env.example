# Sentinel Flare Environment Variables

# =============================================================================
# Security
# =============================================================================

# Set this in production. Do not allow the app to generate a new secret on restart.
SECRET_KEY=replace_with_a_long_random_secret

# Required to read or publish local cross-bot event-bus records through /api/bus.
# Must be replaced with a real non-placeholder value of at least 32 characters.
DARKPOOL_EVENT_BUS_SECRET=replace_with_a_long_random_event_bus_secret

# Required for Sentinel Edge to post authenticated trade-intent decisions back to Darkpool.
# Must be replaced with a real non-placeholder value of at least 32 characters.
DARKPOOL_EDGE_DECISION_SECRET=replace_with_a_long_random_edge_decision_secret

# =============================================================================
# API Keys (optional - FINRA is free and keyless; other free tiers still require accounts)
# =============================================================================

# Alpaca Basic - historical SIP trades outside the latest 15 minutes
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Massive Stocks - free tier is end-of-day/backfill oriented; tick endpoint depends on entitlement
MASSIVE_API_KEY=your_massive_api_key_here

# Tradier Brokerage - real-time market data is for eligible brokerage account holders
TRADIER_ACCESS_TOKEN=your_tradier_access_token_here

# Polygon.io - https://polygon.io
POLYGON_API_KEY=your_polygon_api_key_here

# Intrinio - https://intrinio.com  
INTRINIO_API_KEY=your_intrinio_api_key_here

# Unusual Whales - options flow, dark pool, GEX/VEX, news, halts
UNUSUAL_WHALES_API_KEY=your_unusual_whales_api_key_here

# =============================================================================
# Discord Bot (optional)
# =============================================================================

# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: Your server ID for faster command registration
DISCORD_GUILD_ID=your_server_id_here

# Required for public Discord interaction webhooks.
DISCORD_PUBLIC_KEY=your_discord_application_public_key_here

# Set to true only for local tests or private development payloads.
ALLOW_UNSIGNED_DISCORD_INTERACTIONS=false

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the FastAPI server (default: 8000)
PORT=8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Alert Configuration
# =============================================================================

# Default whale alert threshold (shares)
WHALE_THRESHOLD=100000

# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=your_webhook_url_here
